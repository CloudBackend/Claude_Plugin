<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" vc:minVersion="1.1" elementFormDefault="qualified">

  <!-- ============================================================= -->
  <!-- process scaffold (framework structure; not from the op docs)  -->
  <!-- ============================================================= -->

  <xs:complexType name="t_trigger">
    <!-- Same <param> mechanism as <operation name="call">. -->
    <xs:sequence>
      <xs:element name="param" type="op_call__param" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="event" type="xs:string" use="required"/>
    <xs:attribute name="step" type="xs:string" use="required"/>
    <xs:attribute name="communicator" type="xs:string"/>
    <xs:attribute name="component" type="xs:string"/>
    <xs:attribute name="process" type="xs:string"/>
    <xs:attribute name="view" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_step">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias"/>
      <xs:element ref="operation"/>
      <!-- Shorthand for <operation name="debug">, used at step level in
           production process code. -->
      <xs:element name="debug" type="t_stepDebug"/>
      <xs:element name="if" type="t_if"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="success" type="xs:string"/>
    <xs:attribute name="error" type="xs:string"/>
    <xs:attribute name="goto" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_stepDebug" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="value" type="xs:string"/>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- Shorthand for <operation name="decision"> carrying a single when
       statement: the attributes are the when's, the children are the branch
       that runs when the test holds (PO_decision.js). -->
  <xs:complexType name="t_if">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias"/>
      <xs:element ref="operation"/>
      <xs:element name="debug" type="t_stepDebug"/>
      <xs:element name="if" type="t_if"/>
    </xs:choice>
    <xs:attribute name="exists" type="xs:boolean"/>
    <!-- data: test against the document root instead of the operation's selection. -->
    <xs:attribute name="model">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="data"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="test" type="xs:string"/>
    <xs:attribute name="step" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_decision">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="when" type="t_when"/>
      <xs:element name="otherwise" type="t_otherwise"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_when">
    <xs:attribute name="step" type="xs:string" use="required"/>
    <xs:attribute name="exists" type="xs:boolean"/>
    <xs:attribute name="test" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="t_otherwise">
    <xs:attribute name="step" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:simpleType name="t_model">
    <xs:restriction base="xs:string">
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="t_alias" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <!-- Not required: production process code declares a bare <alias/> and
         assigns to it later. -->
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="model" type="t_model"/>
    <xs:attribute name="mode" type="xs:string"/>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="value" type="xs:string"/>
    <xs:attribute name="when">
      <xs:simpleType>
        <xs:restriction base="xs:string">
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- <operations> declares the custom operations an application provides.
       The declared @name values become usable as <operation name="..."> in
       steps (accepted as open content by the host validator). -->
  <xs:complexType name="t_operations">
    <xs:sequence>
      <xs:element name="operation" type="t_operationDecl" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="t_operationDecl">
    <xs:attribute name="name" type="t_operationNameCustom" use="required"/>
    <xs:attribute name="href" type="xs:anyURI"/>
    <xs:attribute name="class" type="xs:string"/>
  </xs:complexType>

  <!-- Operations added by the project: any well-formed name; the schema cannot
       know what a project registers. -->
  <xs:simpleType name="t_operationNameCustom">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z_][A-Za-z0-9_.\-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The built-in operation names. Closed on purpose so typos are caught.
       EXTENDED AT DEPLOY TIME: the pre-validation schema rewrite appends an
       enumeration per custom operation the application registers (via
       <operations> or boot.addOperation), and may add matching xs:alternative
       rules on the operation element below. -->
  <xs:simpleType name="t_operationNameBuiltIn">
    <xs:restriction base="xs:string">
      <xs:enumeration value="action"/>
      <xs:enumeration value="bind"/>
      <xs:enumeration value="call"/>
      <xs:enumeration value="callMethod"/>
      <xs:enumeration value="callService"/>
      <xs:enumeration value="change"/>
      <xs:enumeration value="channel"/>
      <xs:enumeration value="close"/>
      <xs:enumeration value="config"/>
      <xs:enumeration value="confirm"/>
      <xs:enumeration value="create"/>
      <xs:enumeration value="database"/>
      <xs:enumeration value="debug"/>
      <xs:enumeration value="decision"/>
      <xs:enumeration value="download"/>
      <xs:enumeration value="foreach"/>
      <xs:enumeration value="friends"/>
      <xs:enumeration value="groups"/>
      <xs:enumeration value="login"/>
      <xs:enumeration value="navigate"/>
      <xs:enumeration value="open"/>
      <xs:enumeration value="print"/>
      <xs:enumeration value="rollBack"/>
      <xs:enumeration value="save"/>
      <xs:enumeration value="search"/>
      <xs:enumeration value="setSelection"/>
      <xs:enumeration value="share"/>
      <xs:enumeration value="split"/>
      <xs:enumeration value="stats"/>
      <xs:enumeration value="system"/>
      <xs:enumeration value="tenant"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="process">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="operations" type="t_operations"/>
      <xs:element name="trigger" type="t_trigger"/>
      <xs:element name="step" type="t_step"/>
      <xs:element name="decision" type="t_decision"/>
      <xs:element name="script" type="t_processScript"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="author" type="xs:string"/>
    <xs:attribute name="created" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="revised" type="xs:string"/>
    <!-- The step the process starts in (SYS_Process_getInitialStep). -->
    <xs:attribute name="step" type="xs:string"/>
  </xs:complexType>

  <xs:element name="process" type="process"/>


  <!-- operation element: polymorphic on @name (XSD 1.1 CTA) -->
  <xs:element name="operation" type="xs:anyType">
    <xs:alternative test="@name='action'" type="op_action"/>
    <xs:alternative test="@name='bind'" type="op_bind"/>
    <xs:alternative test="@name='call'" type="op_call"/>
    <xs:alternative test="@name='callMethod'" type="op_callMethod"/>
    <xs:alternative test="@name='callService'" type="op_callService"/>
    <xs:alternative test="@name='change'" type="op_change"/>
    <xs:alternative test="@name='channel'" type="op_channel"/>
    <xs:alternative test="@name='close'" type="op_close"/>
    <xs:alternative test="@name='confirm'" type="op_confirm"/>
    <xs:alternative test="@name='create'" type="op_create"/>
    <xs:alternative test="@name='database'" type="op_database"/>
    <xs:alternative test="@name='debug'" type="op_debug"/>
    <xs:alternative test="@name='decision'" type="op_decision"/>
    <xs:alternative test="@name='foreach'" type="op_foreach"/>
    <xs:alternative test="@name='friends'" type="op_friends"/>
    <xs:alternative test="@name='groups'" type="op_groups"/>
    <xs:alternative test="@name='login'" type="op_login"/>
    <xs:alternative test="@name='navigate'" type="op_navigate"/>
    <xs:alternative test="@name='open'" type="op_open"/>
    <xs:alternative test="@name='print'" type="op_print"/>
    <xs:alternative test="@name='rollBack'" type="op_rollBack"/>
    <xs:alternative test="@name='save'" type="op_save"/>
    <xs:alternative test="@name='search'" type="op_search"/>
    <xs:alternative test="@name='setSelection'" type="op_setSelection"/>
    <xs:alternative test="@name='share'" type="op_share"/>
    <xs:alternative test="@name='split'" type="op_split"/>
    <xs:alternative test="@name='tenant'" type="op_tenant"/>
    <!-- config, system and download (production operations without a typed
         op_* model) and deploy-time-registered custom operations fall through
         to op__any, whose name enumeration validates them. -->
    <xs:alternative type="op__any"/>
  </xs:element>
  <!-- Generic child used by operation children whose content the schema does
       not model in detail: any text content, open child elements. Attributes
       are NOT open — they stay strictly validated. -->
  <xs:complexType name="op__anyContent" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <!-- A process-level script, inline or linked with href. -->
  <xs:complexType name="t_processScript" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="href" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="op__any" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="t_operationNameBuiltIn" use="required"/>
    <xs:anyAttribute namespace="##any" processContents="skip"/>
  </xs:complexType>

  <!-- operation: action -->
  <xs:complexType name="op_action">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="component" type="op_action__component" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="view" type="op_action__view" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="action"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:assert test="count(component) &gt;= 1 or count(view) &gt;= 1"/>
  </xs:complexType>
  <xs:complexType name="op_action__component" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="action" type="xs:string" use="required"/>
  </xs:complexType>
  <!-- Targets the view the operation's value addresses, e.g.
       <view action="focus"/>. -->
  <xs:complexType name="op_action__view" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="action" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- operation: bind -->
  <xs:complexType name="op_bind">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="component" type="op_bind__component" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="paging" type="op_bind__paging" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="bind"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:assert test="count(component) &gt;= 1"/>
  </xs:complexType>
  <xs:complexType name="op_bind__component" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="view" type="xs:string" use="required"/>
    <xs:attribute name="select" type="xs:string"/>
    <xs:attribute name="model" default="default">
      <xs:simpleType>
        <xs:restriction base="xs:string">
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="transformer" type="xs:string"/>
    <xs:attribute name="type" default="default">
      <xs:simpleType>
        <xs:restriction base="xs:string">
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="eval" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="op_bind__paging" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="size" type="xs:integer" use="required"/>
    <xs:attribute name="ascending" type="xs:boolean" default="true"/>
    <xs:attribute name="order" type="xs:string"/>
  </xs:complexType>

  <!-- operation: call -->
  <xs:complexType name="op_call">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="trigger" type="op_call__trigger" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="yield" type="op_call__yield" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="param" type="op_call__param" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="timer" type="op_call__timer" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="call"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_call__trigger" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="model" type="xs:string"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_call__yield" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_call__param" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_call__timer" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="alias" type="xs:string"/>
    <xs:attribute name="interval" type="xs:string"/>
    <xs:attribute name="wait" type="xs:integer"/>
  </xs:complexType>

  <!-- operation: callMethod -->
  <xs:complexType name="op_callMethod">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="method" type="op_callMethod__method" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="callMethod"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
    <xs:attribute name="wait" type="xs:boolean" default="false"/>
    <xs:attribute name="then" type="xs:string"/>
    <xs:assert test="count(method) &gt;= 1"/>
  </xs:complexType>
  <xs:complexType name="op_callMethod__method" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="param" type="op_callMethod__method__param" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="alias" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_callMethod__method__param" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="type" default="string">
      <xs:simpleType>
        <xs:restriction base="xs:string">
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- operation: callService -->
  <xs:complexType name="op_callService">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="body" type="op_callService__body" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="document" type="op_callService__document" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="expect" type="op_callService__expect" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="headers" type="op_callService__headers" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="method" type="op_callService__method" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="param" type="op_callService__param" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="silent" type="op_callService__silent" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="wait" type="op_callService__wait" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="only-url" type="op_callService__only-url" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="callService"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_callService__body" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="type" type="xs:string"/>
    <xs:attribute name="eval" type="xs:string" default="true"/>
  </xs:complexType>
  <xs:complexType name="op_callService__document" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__expect" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="attempts" type="xs:string" default="30"/>
    <xs:attribute name="timeout" type="xs:string" default="10"/>
  </xs:complexType>
  <xs:complexType name="op_callService__headers" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__method" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__param" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_callService__silent" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__wait" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="op_callService__only-url" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <!-- operation: change -->
  <xs:complexType name="op_change">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="store" type="op_change__store" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="move" type="op_change__move" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="delete" type="op_change__delete" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
    <xs:attribute name="name" type="xs:string" use="required" fixed="change"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="op_change__store" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="model" type="op_change__model"/>
    <xs:attribute name="select" type="xs:string"/>
    <xs:attribute name="transformer" type="xs:string"/>
    <xs:attribute name="type" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string"/>
  </xs:complexType>
  <!-- What select is relative to (PO_change.js): data = the document root,
       base = the event's xpath. Without it, the operation's value selection. -->
  <xs:simpleType name="op_change__model">
    <xs:restriction base="xs:string">
      <xs:enumeration value="data"/>
      <xs:enumeration value="base"/>
    </xs:restriction>
  </xs:simpleType>
  <!-- Exactly one of before/after/into is the destination. -->
  <xs:complexType name="op_change__move">
    <xs:attribute name="select" type="xs:string" use="required"/>
    <xs:attribute name="before" type="xs:string"/>
    <xs:attribute name="after" type="xs:string"/>
    <xs:attribute name="into" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="op_change__delete" mixed="true">
    <xs:sequence minOccurs="0" maxOccurs="unbounded">
      <xs:any namespace="##any" processContents="skip"/>
    </xs:sequence>
    <xs:attribute name="model" type="op_change__model"/>
    <xs:attribute name="select" type="xs:string"/>
  </xs:complexType>

  <!-- operation: channel -->
  <xs:complexType name="op_channel">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="alias" type="t_alias" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="name" type="op_channel__name" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="protocol" type="op_channel__protocol" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="adapter" type="op_channel__adapter" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="authentication" type="op_channel__authentication" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="title" type="op_channel__title" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="drive" type="op_channel__drive" minOccurs="0" maxOccurs="unbounded"/>
    </xs:choice>
